{
  "name": "footbal-choyse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:web": "npm run build && node scripts/build-web.mjs",
    "test:contact": "npm run build:web && node scripts/test-contact.cjs",
    "test:menu": "npm run build:web && node scripts/test-main-menu.cjs",
    "test:browser": "npm run build:web && node scripts/test-browser.cjs",
    "test:desktop": "npm run build:web && node scripts/test-desktop.cjs",
    "test:controls": "npm run build:web && node scripts/test-controls.cjs",
    "test:var": "npm run build:web && node scripts/test-var.cjs",
    "test:stadiums": "npm run build:web && node scripts/test-stadiums.cjs",
    "test:crowd": "npm run build:web && node scripts/test-crowd.cjs",
    "test:leagues": "npm run build:web && node scripts/test-leagues.cjs",
    "test:special-leagues": "npm run build:web && node scripts/test-special-leagues.cjs",
    "test:dribble": "npm run build:web && node scripts/test-dribble.cjs",
    "test:season-rollover": "npm run build:web && node scripts/test-season-rollover.cjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.160.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
